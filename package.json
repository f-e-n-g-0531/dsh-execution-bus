{
  "name": "@feng0531/dsh-execution-bus",
  "version": "1.5.1",
  "type": "module",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-e-n-g-0531/dsh-execution-bus.git"
  },
  "description": "萧何 / Xiao He: declarative runtime for DSH agent tool plans (DAG execution, retries, persistence, recovery)",
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./mode": "./dist/mode.js",
    "./test-mode": "./dist/mode.js",
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "docs",
    "scripts/acceptance-report.mjs",
    "scripts/pilot-report.mjs",
    "scripts/pilot-manifest.mjs",
    "scripts/benchmark-runtime.mjs",
    "scripts/session-metrics.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack": "npm pack",
    "check": "npm test",
    "test:flow": "npm run build && node --test test/runtime-tools.test.mjs test/runtime-executor.test.mjs test/runtime-ptc.test.mjs",
    "prepack": "npm run check && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "test:install": "node scripts/test-install.mjs",
    "pack:candidate": "node scripts/pack.mjs",
    "verify:release": "node scripts/release-preflight.mjs",
    "metrics:sessions": "node scripts/session-metrics.mjs",
    "acceptance:report": "node scripts/acceptance-report.mjs",
    "pilot:report": "node scripts/pilot-report.mjs",
    "pilot:manifest": "node scripts/pilot-manifest.mjs",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-include": "~1.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": "0.2.2-rc.1",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-pwsh": "0.2.2-rc.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22",
    "fast-check": "^4.10.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  }
}
